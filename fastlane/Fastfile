# BaliSurf — release automation. Ported from chiliec/slovo's Fastfile.
#
# iOS (TestFlight + App Store): gym archives the committed iosApp Xcode project
# (its Run Script phase shells to ./gradlew
# :composeApp:embedAndSignAppleFrameworkForXcode to build the Compose
# Multiplatform framework), an Apple Distribution certificate plus a
# sigh-fetched App Store provisioning profile provide signing, and pilot
# uploads to TestFlight. All App Store Connect auth is via the API key — no
# Apple ID, no 2FA, and no separate certs repo.
#
# iOS signing model (no match, no extra repo):
#   * Apple Distribution cert + key: base64 .p12 in DIST_CERT_P12. CI imports it
#     into a temp keychain each run.
#   * App Store provisioning profile: fetched/created fresh each run with sigh via
#     the API key (always re-downloadable from Apple).
#   Run `bundle exec fastlane ios signing_assets` ONCE locally to create the cert
#   and produce the .p12 to base64 into the DIST_CERT_P12 secret.
#
# Android (Google Play): gradle builds the signed AAB (upload key from the
# gitignored keystore.properties at the repo root), supply pushes it plus the
# listing to Google Play. Play App Signing means Google holds the real app
# signing key; we only ever hold the upload key.
#
# Local usage:
#   bundle exec fastlane ios signing_assets       # one-time: create cert + profile
#   bundle exec fastlane ios beta                 # build + upload to TestFlight
#   bundle exec fastlane ios release              # push listing text + screenshots
#   bundle exec fastlane ios submit               # submit for App Store review
#   bundle exec fastlane android play_stage       # stage listing only, no auth needed
#   bundle exec fastlane android bundle           # build the AAB (no auth)
#   bundle exec fastlane android play_internal    # build AAB + upload to internal track
#   bundle exec fastlane android play_closed      # build AAB + upload to closed track
#   bundle exec fastlane android play_listing     # push listing text/images only
#   bundle exec fastlane android play_promote     # internal -> production
#
# Required environment (fastlane/.env locally; GitHub secrets in CI):
#   ASC_KEY_ID            App Store Connect API Key ID
#   ASC_ISSUER_ID         App Store Connect API Issuer ID (UUID)
#   ASC_KEY_P8            The .p8 private key CONTENTS (base64) — CI only
#   DIST_CERT_P12         Apple Distribution cert+key as base64 .p12 — CI only
#   DIST_CERT_PASSWORD    Password the .p12 was exported with (may be empty)
#   APP_VERSION           iOS marketing version to operate on (default 1.0.0)
#   PLAY_JSON_KEY         Play service account JSON contents (base64) — CI only
#   ANDROID_VERSION_CODE  Pin the versionCode; the upload lanes otherwise derive it
# Upload-key signing. The lanes read the gitignored keystore.properties at the
# repo root; CI rebuilds that file from these four secrets (android-play.yml):
#   ANDROID_KEYSTORE_BASE64    The upload .jks as base64 — CI only
#   ANDROID_KEYSTORE_PASSWORD  storePassword
#   ANDROID_KEY_ALIAS          keyAlias (currently "balisurf")
#   ANDROID_KEY_PASSWORD       keyPassword
#
# Prerequisites that need a human once:
#   * Play Console account, app record for cx.viz.balisurf, Play App Signing
#     enrolled, service account JSON with "Release manager" access (see
#     docs/release-android.md).
#   * App Store Connect: app record for cx.viz.balisurf + an API key with
#     App Manager access.

require "base64"

default_platform(:android)

# ---------------------------------------------------------------------------
# iOS / TestFlight + App Store
# ---------------------------------------------------------------------------

APP_IDENTIFIER = "cx.viz.balisurf"
XCODEPROJ = File.expand_path("../iosApp/iosApp.xcodeproj", __dir__)
SCHEME    = ENV.fetch("IOS_SCHEME", "iosApp")
# Marketing version the release/submit lanes operate on. Keep in sync with
# MARKETING_VERSION in the Xcode project.
APP_VERSION = ENV.fetch("APP_VERSION", "1.0.0")
# setup_ci creates this keychain on CI; import_certificate must target it.
CI_KEYCHAIN = "fastlane_tmp_keychain"

# Loads the App Store Connect API key. Accepts the .p8 either as base64 contents
# in ASC_KEY_P8 (CI) or, for local dev, a gitignored AuthKey_<id>.p8 in the repo
# root.
def asc_api_key
  if ENV["ASC_KEY_P8"] && !ENV["ASC_KEY_P8"].empty?
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )
  else
    key_path = Dir[File.expand_path("../AuthKey_*.p8", __dir__)].first
    UI.user_error!("No ASC_KEY_P8 env and no AuthKey_*.p8 in the repo root") unless key_path
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID", File.basename(key_path)[/AuthKey_(.+)\.p8/, 1]),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )
  end
end

# On CI, imports the base64 Apple Distribution .p12 into the temp keychain.
# Locally this is a no-op — the cert is expected in the login keychain.
def import_dist_cert
  return unless ENV["DIST_CERT_P12"] && !ENV["DIST_CERT_P12"].empty?
  p12_path = File.expand_path("../build/dist_cert.p12", __dir__)
  FileUtils.mkdir_p(File.dirname(p12_path))
  File.binwrite(p12_path, Base64.decode64(ENV["DIST_CERT_P12"]))
  import_certificate(
    certificate_path: p12_path,
    certificate_password: ENV["DIST_CERT_PASSWORD"].to_s,
    keychain_name: CI_KEYCHAIN,
    keychain_password: ""
  )
ensure
  FileUtils.rm_f(p12_path) if defined?(p12_path) && p12_path
end

# On CI, imports the Apple WWDR intermediate certificates into the temp keychain.
# Without them the distribution cert's chain cannot be validated, so
# `security find-identity -v -p codesigning` reports no identities. No-op locally.
def import_apple_wwdr
  return unless ENV["CI"]
  %w[AppleWWDRCAG3 AppleWWDRCAG6].each do |name|
    path = File.expand_path("../build/#{name}.cer", __dir__)
    FileUtils.mkdir_p(File.dirname(path))
    next unless system("curl", "-fsSL", "https://www.apple.com/certificateauthority/#{name}.cer", "-o", path)
    import_certificate(certificate_path: path, keychain_name: CI_KEYCHAIN, keychain_password: "")
  end
end

platform :ios do
  desc "One-time (local): create the Apple Distribution cert + App Store profile"
  lane :signing_assets do
    api_key = asc_api_key
    out = File.expand_path("../build/certs", __dir__)
    FileUtils.mkdir_p(out)
    # Creates (or downloads) the Apple Distribution certificate + private key.
    cert(api_key: api_key, output_path: out)
    # Creates/downloads the App Store provisioning profile.
    get_provisioning_profile(
      api_key: api_key, app_identifier: APP_IDENTIFIER, readonly: false, output_path: out
    )
    UI.success("Signing assets in #{out}.")
    UI.message("Export the cert+key as a .p12 (Keychain Access, or the .p12 in that dir),")
    UI.message("then: base64 -i <that>.p12 | pbcopy  ->  paste into the DIST_CERT_P12 secret.")
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # CI prepares the signing keychain in a dedicated workflow step (manual
    # `security` setup with key-partition-list). Skip fastlane's own keychain
    # handling there; still run it for local invocations.
    unless ENV["SKIP_KEYCHAIN_SETUP"]
      setup_ci if ENV["CI"]     # temp keychain on CI (no-op locally)
      import_apple_wwdr          # CI: WWDR intermediates so the cert chain validates
      import_dist_cert           # CI: load the distribution cert from the secret
    end

    # Fetch/create the App Store provisioning profile via the API key.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )

    UI.user_error!("Expected Xcode project at #{XCODEPROJ}") unless Dir.exist?(XCODEPROJ)

    # Auto-increment the build number: highest build already on TestFlight + 1.
    # initial_build_number: 0 handles the virgin app record (no builds yet) -> 1.
    # The query is unscoped (no version:) so it is always monotonic.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ) + 1
    UI.message("Auto-incremented build number: #{next_build}")
    increment_build_number_in_xcodeproj(
      build_number: next_build.to_s,
      xcodeproj: XCODEPROJ,
      target: SCHEME
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] ||
                   ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: profile_name
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.expand_path("../build/ios", __dir__),
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        signingStyle: "manual"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Prepare the App Store listing: push metadata + screenshots (does NOT submit)"
  # Uploads the App Store text (store-assets/metadata/ios/) and the iPhone
  # screenshots to the APP_VERSION App Store version, WITHOUT submitting for review
  # and WITHOUT uploading a binary (the build is already on TestFlight via the beta
  # lane). Review the result in App Store Connect, then run the submit lane.
  lane :release do
    api_key = asc_api_key

    # Screenshots live canonically under store-assets/screenshots/ios (shared with
    # the release docs). deliver wants a <lang>/ tree and classifies each shot by
    # its pixel size, so stage copies into a gitignored dir each run — the single
    # source of truth stays in store-assets/.
    src   = File.expand_path("../store-assets/screenshots/ios", __dir__)
    root  = File.expand_path("screenshots", __dir__)
    lang  = File.join(root, "en-US")
    shots = Dir[File.join(src, "*.png")]
    UI.user_error!("No screenshots in #{src} — capture them first") if shots.empty?
    FileUtils.rm_rf(root)
    FileUtils.mkdir_p(lang)
    FileUtils.cp(shots, lang)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      metadata_path: File.expand_path("../store-assets/metadata/ios", __dir__),
      screenshots_path: root,
      skip_binary_upload: true,        # build already on TestFlight (beta lane)
      overwrite_screenshots: true,
      submit_for_review: false,        # PREPARE ONLY — submit via the submit lane
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true                      # non-interactive: skip the HTML preview
    )
  end

  desc "Publish App Privacy: 'Data Not Collected' (needs an Apple ID + 2FA, not the API key)"
  # The App Privacy resources (apps/<id>/dataUsages) live ONLY on the iris API
  # behind a web session — with an API-key token they 404 ("relationship
  # 'dataUsages' does not exist"). So this one lane asks for FASTLANE_USER and a
  # 2FA code; everything it uploads is in fastlane/app_privacy_details.json
  # (no data collected, matching PRIVACY.md).
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      username: ENV.fetch("FASTLANE_USER") { UI.user_error!("Set FASTLANE_USER to the Apple ID") },
      team_id: ENV["FASTLANE_ITC_TEAM_ID"],
      app_identifier: APP_IDENTIFIER,
      json_path: File.expand_path("app_privacy_details.json", __dir__)
    )
  end

  desc "Submit the APP_VERSION App Store version for review (attaches the latest build)"
  # Assumes the listing is already uploaded (release lane), the age rating and
  # content-rights declaration are set, Pricing is set to Free, and App Privacy is
  # PUBLISHED in the App Store Connect web UI — Apple rejects the submission
  # otherwise. deliver selects the latest build for the version and submits. This
  # is the actual public submission to Apple review.
  lane :submit do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      },
      force: true
    )
  end
end

# ---------------------------------------------------------------------------
# Android / Google Play
# ---------------------------------------------------------------------------

PACKAGE_NAME  = "cx.viz.balisurf"
AAB_PATH      = File.expand_path("../composeApp/build/outputs/bundle/release/composeApp-release.aab", __dir__)
# Staged supply metadata tree (gitignored, rebuilt each run). The single source of
# truth stays in store-assets/.
PLAY_STAGE    = File.expand_path("play-metadata", __dir__)

# Resolves the Play service account JSON: base64 in PLAY_JSON_KEY (CI) or a
# gitignored play-service-account.json in the repo root (local).
def play_json_key
  if ENV["PLAY_JSON_KEY"] && !ENV["PLAY_JSON_KEY"].empty?
    path = File.expand_path("../build/play-service-account.json", __dir__)
    FileUtils.mkdir_p(File.dirname(path))
    File.binwrite(path, Base64.decode64(ENV["PLAY_JSON_KEY"]))
    path
  else
    path = File.expand_path("../play-service-account.json", __dir__)
    unless File.exist?(path)
      UI.user_error!("No PLAY_JSON_KEY env and no play-service-account.json in the repo root. " \
                     "See docs/release-android.md for how to create the service account key.")
    end
    path
  end
end

# Copies store-assets/ into the <lang>/ layout supply expects and returns the
# metadata_path to hand it. Rebuilt from scratch each run so deletions propagate.
def stage_play_metadata
  meta_src = File.expand_path("../store-assets/metadata/android", __dir__)
  shots_src = File.expand_path("../store-assets/screenshots/android", __dir__)
  icon_src = File.expand_path("../store-assets/icons/play-icon-512.png", __dir__)
  feature_src = File.expand_path("../store-assets/feature-graphic/play-feature-1024x500.png", __dir__)

  UI.user_error!("No Android metadata at #{meta_src}") unless Dir.exist?(meta_src)
  shots = Dir[File.join(shots_src, "*.png")].sort
  UI.user_error!("No screenshots in #{shots_src} — capture them first") if shots.empty?
  [icon_src, feature_src].each do |p|
    UI.user_error!("Missing required Play image: #{p}") unless File.exist?(p)
  end

  FileUtils.rm_rf(PLAY_STAGE)
  FileUtils.mkdir_p(PLAY_STAGE)
  # Copy every locale dir (title/short_description/full_description/changelogs).
  Dir[File.join(meta_src, "*")].each { |d| FileUtils.cp_r(d, PLAY_STAGE) if File.directory?(d) }

  Dir[File.join(PLAY_STAGE, "*")].select { |d| File.directory?(d) }.each do |lang_dir|
    phone = File.join(lang_dir, "images", "phoneScreenshots")
    FileUtils.mkdir_p(phone)
    FileUtils.cp(shots, phone)
    FileUtils.cp(icon_src, File.join(lang_dir, "images", "icon.png"))
    FileUtils.cp(feature_src, File.join(lang_dir, "images", "featureGraphic.png"))
  end

  PLAY_STAGE
end

# Play rejects any upload whose versionCode is not strictly greater than every
# code already on the account, so derive the next one from Play itself rather
# than tracking it in git. Returns 1 for a virgin app record.
def next_play_version_code
  key = play_json_key
  codes = %w[internal alpha beta production].flat_map do |track|
    google_play_track_version_codes(
      package_name: PACKAGE_NAME,
      json_key: key,
      track: track
    ) || []
  rescue StandardError => e
    # A track with no releases 404s; that is normal, not fatal.
    UI.important("Skipping the #{track} track while resolving versionCode: #{e.message}")
    []
  end

  next_code = (codes.map(&:to_i).max || 0) + 1
  UI.message("Auto-incremented versionCode: #{next_code} (highest on Play: #{codes.max || 'none'})")
  next_code
end

# Builds the signed release AAB. Signing comes from the gitignored
# keystore.properties at the repo root; without it the build succeeds but is
# UNSIGNED and Play will reject it, so check the output explicitly.
#
# version_code is passed through to Gradle as -PversionCode; nil leaves the
# build file's default of 1 (fine for local verification, never for an upload).
def build_aab(version_code: nil, require_signing: true)
  UI.message("Building AAB with versionCode=#{version_code || '1 (build file default)'}")
  gradle(
    task: ":composeApp:bundle",
    build_type: "Release",
    project_dir: File.expand_path("..", __dir__),
    properties: version_code ? { "versionCode" => version_code } : {}
  )
  UI.user_error!("Expected an AAB at #{AAB_PATH}") unless File.exist?(AAB_PATH)
  unless File.exist?(File.expand_path("../keystore.properties", __dir__))
    msg = "No keystore.properties at the repo root — the AAB is UNSIGNED and Play " \
          "will reject it. See docs/release-android.md."
    # Only an upload needs a signed AAB; the bundle lane exists precisely to be
    # runnable without credentials (CI dry run), so there it is a warning.
    require_signing ? UI.user_error!(msg) : UI.important(msg)
  end
  AAB_PATH
end

# Shared body for the testing-track lanes: one build, uploaded to [track].
def play_upload_build(track)
  build_aab(version_code: ENV["ANDROID_VERSION_CODE"] || next_play_version_code)

  upload_to_play_store(
    package_name: PACKAGE_NAME,
    json_key: play_json_key,
    aab: AAB_PATH,
    track: track,
    metadata_path: stage_play_metadata,
    # a human reviews in the console before rollout
    release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft"),
    skip_upload_apk: true,
    validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1"
  )
end

platform :android do
  desc "Stage the Play listing from store-assets/ without uploading (no credentials needed)"
  # Verification lane: proves the store-assets -> supply layout mapping works
  # before any Play account exists. Prints the tree it produced.
  lane :play_stage do
    path = stage_play_metadata
    UI.success("Staged Play metadata at #{path}")
    Dir.glob(File.join(path, "**", "*")).sort.each do |f|
      UI.message("  #{f.sub("#{path}/", "")}#{File.directory?(f) ? "/" : ""}")
    end
  end

  desc "Build the signed release AAB"
  # Stays credential-free so it can be verified without a Play account: set
  # ANDROID_VERSION_CODE to pin a code, otherwise the build file default (1) is
  # used. play_internal is what resolves the real code from Play.
  lane :bundle do
    build_aab(version_code: ENV["ANDROID_VERSION_CODE"], require_signing: false)
    UI.success("AAB: #{AAB_PATH}")
  end

  desc "Build and upload a new build to the Play internal testing track"
  lane :play_internal do
    play_upload_build("internal")
  end

  desc "Build and upload a new build to the closed testing track"
  # Production access for personal accounts created after 2023-11-13 needs 12
  # testers opted in to a CLOSED track for 14 consecutive days — internal and open
  # testing do not count towards it. This lane starts that clock. The default
  # draft status does NOT: a draft is invisible to testers, so publish the release
  # in the console (or pass PLAY_RELEASE_STATUS=completed) before counting days.
  lane :play_closed do
    play_upload_build(ENV.fetch("PLAY_CLOSED_TRACK", "alpha"))
  end

  desc "Push the Play listing (text, screenshots, graphics) without a binary"
  lane :play_listing do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key: play_json_key,
      metadata_path: stage_play_metadata,
      # supply resolves a track+release even for a listing-only push and defaults
      # to production, which has no release until launch. Point it at internal.
      track: ENV.fetch("PLAY_LISTING_TRACK", "internal"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,    # changelogs belong to a release, not the listing
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1"
    )
  end

  desc "Promote the internal-track build to production (staged rollout)"
  # PLAY_ROLLOUT is the fraction of users, e.g. 0.1 for 10%. Defaults to a full
  # rollout; set release_status to draft first time so it can be reviewed.
  lane :play_promote do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key: play_json_key,
      track: "internal",
      track_promote_to: "production",
      rollout: ENV.fetch("PLAY_ROLLOUT", "1.0"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1"
    )
  end
end
