# Copy to keystore.properties (gitignored) to enable signed release builds.
# Generate an upload keystore with:
#   keytool -genkeypair -v -keystore balisurf-upload.jks -alias balisurf \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=BaliSurf, O=viz.cx, C=US"
#
# With Google Play App Signing enabled, this is only the UPLOAD key — if lost it
# can be reset via the Play Console. Still: BACK IT UP and keep the passwords safe.
storeFile=balisurf-upload.jks
storePassword=CHANGE_ME
keyAlias=balisurf
keyPassword=CHANGE_ME
